<header class="absolute inset-x-0 top-0 z-50">
    <nav class="container-site flex h-24 items-center justify-between">
        <a
            href="/"
            class="relative z-50 font-display text-xl font-extrabold tracking-tight text-white"
            aria-label="OMRI COMPTA — Accueil"
        >
            {" "}
            OMRI <span class="text-primary-400">COMPTA</span>{" "}
        </a>{" "}
        <!-- Desktop navigation -->
        <div class="hidden items-center gap-8 md:flex">
            <a
                href="#expertise"
                class="text-sm font-medium text-white/80 transition hover:text-white"
            >
                {" "}
                Expertise{" "}
            </a>{" "}
            <a
                href="#cabinet"
                class="text-sm font-medium text-white/80 transition hover:text-white"
            >
                {" "}
                Le cabinet{" "}
            </a>{" "}
            <a
                href="#contact"
                class="rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white hover:text-ink"
            >
                {" "}
                Nous contacter{" "}
            </a>
        </div>
        <!-- Mobile menu button -->{" "}
        <button
            id="mobile-menu-button"
            type="button"
            class="relative z-50 flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white transition hover:bg-white hover:text-ink md:hidden"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg
                id="menu-open-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M4 6h16" />
                <path d="M4 12h16" />
                <path d="M4 18h16" />
            </svg>{" "}
            <svg
                id="menu-close-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="hidden"
            >
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
            </svg>
        </button>
    </nav>
    <!-- Mobile navigation -->
    <div
        id="mobile-menu"
        class="pointer-events-none fixed inset-0 z-40 flex translate-y-[-100%] flex-col bg-ink px-6 pb-10 pt-32 opacity-0 transition duration-500 ease-out md:hidden"
        aria-hidden="true"
    >
        <div class="container-site flex h-full flex-col">
            <div class="flex flex-col">
                <a
                    href="#expertise"
                    class="mobile-menu-link border-b border-white/10 py-5 font-display text-3xl font-bold text-white"
                >
                    {" "}
                    Expertise{" "}
                </a>{" "}
                <a
                    href="#cabinet"
                    class="mobile-menu-link border-b border-white/10 py-5 font-display text-3xl font-bold text-white"
                >
                    {" "}
                    Le cabinet{" "}
                </a>{" "}
                <a
                    href="#contact"
                    class="mobile-menu-link border-b border-white/10 py-5 font-display text-3xl font-bold text-white"
                >
                    {" "}
                    Contact{" "}
                </a>
            </div>
            <div class="mt-auto border-t border-white/10 pt-6">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/40">
                    Expert comptable à Larache
                </p>
                <a
                    href="tel:0539525229"
                    class="mt-3 block text-lg font-semibold text-white"
                >
                    {" "}
                    05 39 52 52 29{" "}
                </a>{" "}
                <a
                    href="mailto:omri.compta@gmail.com"
                    class="mt-1 block text-sm text-white/60"
                >
                    {" "}
                    omri.compta@gmail.com{" "}
                </a>
            </div>
        </div>
    </div>
</header>
<script>
    const button = document.querySelector("#mobile-menu-button");
    const menu = document.querySelector("#mobile-menu");
    const openIcon = document.querySelector("#menu-open-icon");
    const closeIcon = document.querySelector("#menu-close-icon");
    const links = document.querySelectorAll(".mobile-menu-link");
    if (
        button instanceof HTMLButtonElement &&
        menu instanceof HTMLElement &&
        openIcon instanceof SVGElement &&
        closeIcon instanceof SVGElement
    ) {
        const setMenuState = (open: boolean) => {
            button.setAttribute("aria-expanded", String(open));
            button.setAttribute(
                "aria-label",
                open ? "Fermer le menu" : "Ouvrir le menu",
            );
            menu.setAttribute("aria-hidden", String(!open));
            openIcon.classList.toggle("hidden", open);
            closeIcon.classList.toggle("hidden", !open);
            menu.classList.toggle("pointer-events-none", !open);
            menu.classList.toggle("translate-y-[-100%]", !open);
            menu.classList.toggle("opacity-0", !open);
            menu.classList.toggle("translate-y-0", open);
            menu.classList.toggle("opacity-100", open);
            document.body.style.overflow = open ? "hidden" : "";
        };
        button.addEventListener("click", () => {
            const isOpen = button.getAttribute("aria-expanded") === "true";
            setMenuState(!isOpen);
        });
        links.forEach((link) => {
            link.addEventListener("click", () => {
                setMenuState(false);
            });
        });
        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                button.getAttribute("aria-expanded") === "true"
            ) {
                setMenuState(false);
                button.focus();
            }
        });
    }
</script>
